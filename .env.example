# quietGym native deployment example
#
# Copy these settings to /etc/quietgym/quietgym.env on the server. Keep that
# file outside Git. The API creates its session secret, database and VAPID
# keys inside DATA_DIR on first start, so production must use a new, empty
# directory that has never been committed or shared.

# Production mode enables strict configuration, Origin and WebAuthn checks.
NODE_ENV=production

# Internal address used by the Node API. Caddy will be the only public
# entrypoint, so production refuses non-loopback HOST values.
HOST=127.0.0.1
PORT=3000

# Persistent runtime data. The quietgym service account must be the only
# account with write access to this directory.
DATA_DIR=/var/lib/quietgym

# WebAuthn identity. ORIGIN must be the exact public HTTPS origin and RP_ID
# must be its hostname, without a scheme or path.
ORIGIN=https://gym.example.com
RP_ID=gym.example.com
RP_NAME=quietGym

# A public deployment should normally require invitations. Add user IDs to
# ADMIN_UIDS after the corresponding users have registered.
INVITE_ONLY=true
ADMIN_UIDS=

# Session lifetime for newly issued cookies.
SESSION_DAYS=90

# Require a biometric, device PIN or equivalent user verification for every
# passkey registration and login in production.
WEBAUTHN_USER_VERIFICATION=required

# One passkey flow uses two requests. These defaults allow 15 complete
# attempts per client address in each five-minute window.
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Contact identifier required for Web Push. This is not a secret.
VAPID_SUBJECT=mailto:admin@example.com
