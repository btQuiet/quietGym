# quietGym native deployment example
#
# Copy these settings to /etc/quietgym/quietgym.env on the server. Keep that
# file outside Git. `npm run password:set` creates the database; the API creates
# its session secret and VAPID keys on first start. Production must use a new,
# empty directory that has never been committed or shared.

# Production mode enables strict Origin, HTTPS and loopback checks.
NODE_ENV=production

# Internal address used by the Node API. Caddy will be the only public
# entrypoint, so production refuses non-loopback HOST values.
HOST=127.0.0.1
PORT=2300

# Persistent runtime data. The quietgym service account must be the only
# account with write access to this directory.
DATA_DIR=/var/lib/quietgym

# Exact public HTTPS origin. It is used to protect state-changing requests and
# to mark the 90-day session cookie Secure.
ORIGIN=https://gym.qs-ecosystem.com

# Session lifetime for newly issued cookies.
SESSION_DAYS=90

# Password attempts allowed per client address. The owner password is created
# interactively with `npm run password:set`; never put it in this file.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Contact identifier required for Web Push. This is not a secret.
VAPID_SUBJECT=mailto:admin@example.com
